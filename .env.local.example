# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: Sanity API token (for draft content)
# SANITY_API_TOKEN=your-sanity-api-token

# Umami analytics
# Both are read at build time, not runtime, so a change needs a rebuild.
# SRC is the tracker URL. On Umami Cloud it is the address below. On a self
# hosted instance it is your own domain with /script.js on the end.
# ID is the Website ID, found in Umami under Settings, Websites, Edit.
# Leave either blank and the tracker is not rendered at all.
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_ID=00000000-0000-0000-0000-000000000000

# Diogenes proposal page password (protects /diogenes-proposal)
# Server only, no NEXT_PUBLIC_ prefix. Compared exactly, case sensitive.
DIOGENES_PROPOSAL_PASSWORD=your-password-here

# Northcote proposal page password (protects /northcote-proposal)
# Server only, no NEXT_PUBLIC_ prefix. Trimmed and upper cased before it is
# compared, so entry is case insensitive.
NORTHCOTE_PROPOSAL_PASSWORD=NORTHCOTE

# Resend API key (for questionnaire email submission on /diogenes-proposal)
# Get your key from resend.com. The sending domain (masuyodigital.com) must be verified there.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
